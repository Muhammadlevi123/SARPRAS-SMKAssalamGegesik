generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Sumber {
  PEMBELIAN
  MOU
  BANTUAN
  LAMA
}

// ADMIN : semua fitur + Kelola User + Kelola Tahun Ajaran
// USER  : fitur harian (data master, barang masuk, pengecekan, laporan, pengajuan)
enum Role {
  ADMIN
  USER
}

// Akun hasil register sendiri.
// USER baru bisa login setelah admin memasangkan lokasi (lokasiId terisi).
// ADMIN tidak butuh lokasi.
model User {
  id        Int      @id @default(autoincrement())
  nama      String
  email     String   @unique
  password  String   // hash bcrypt, jangan simpan teks asli
  role      Role     @default(USER)
  lokasiId  Int?     // lokasi tanggung jawab; kosong = menunggu ditetapkan admin
  sesiVersi Int      @default(0) // BARU: naik = semua sesi lama user ini tidak berlaku (misal setelah Keluar)
  createdAt DateTime @default(now())

  lokasi    Lokasi?     @relation(fields: [lokasiId], references: [id], onDelete: SetNull)
  pengajuan Pengajuan[]

  @@index([lokasiId])
}

// Tahun ajaran diatur admin, misal 2026/2027: 13 Juli 2026 – 30 Juni 2027.
// Nama dibuat otomatis dari tahun mulai & tahun selesai.
model TahunAjaran {
  id        Int      @id @default(autoincrement())
  nama      String   @unique // "2026/2027"
  mulai     DateTime @unique
  selesai   DateTime
  createdAt DateTime @default(now())
}

// Tempat barang ditempatkan, misal Bengkel Motor (PJ: Suhardi)
model Lokasi {
  id              Int      @id @default(autoincrement())
  nama            String   @unique
  penanggungJawab String?  // nama PJ (teks), masih dipakai di laporan
  createdAt       DateTime @default(now())

  barang     Barang[]
  pengecekan Pengecekan[]
  users      User[]      // akun yang memegang lokasi ini
  pengajuan  Pengajuan[]
}

// Kategori barang + bagian kode barang. Contoh: Elektronik = ELK
// Bertambah otomatis dari form Barang (kategori baru langsung tersimpan di sini)
// Kode barang: ASG-[kode]-[tahun 2 digit]-[no urut 4 digit] → ASG-ELK-26-0012
model Kategori {
  id         Int      @id @default(autoincrement())
  nama       String   @unique
  kode       String   @unique @db.VarChar(3)
  noTerakhir Int      @default(0) // no urut terakhir yang PERNAH dipakai (tidak pernah turun)
  createdAt  DateTime @default(now())

  barang Barang[]
}

model Barang {
  id             Int      @id @default(autoincrement())
  kode           String   @unique // ASG-ELK-26-0012, dibuat otomatis
  nama           String
  merk           String?  // misal Lenovo, Asus, Tekiro
  kategoriId     Int
  tahunPerolehan Int      // bagian kode barang
  satuan         String   // Pcs, Set, Unit, Buah
  lokasiId       Int
  createdAt      DateTime @default(now())

  lokasi          Lokasi            @relation(fields: [lokasiId], references: [id])
  kategori        Kategori          @relation(fields: [kategoriId], references: [id])
  masukItems      BarangMasukItem[]
  pengecekanItems PengecekanItem[]

  // Nama sama boleh, asal beda merk atau beda lokasi.
  // (Untuk barang tanpa merk, pengecekan duplikat dilakukan di kode)
  @@unique([nama, merk, lokasiId])
  @@index([lokasiId])
  @@index([kategoriId])
}

model Mitra {
  id        Int      @id @default(autoincrement())
  nama      String   @unique
  kontak    String?
  createdAt DateTime @default(now())

  barangMasuk BarangMasuk[]
}

// Satu kejadian barang masuk = satu nota / satu dokumen serah terima
model BarangMasuk {
  id         Int      @id @default(autoincrement())
  tanggal    DateTime
  sumber     Sumber
  noNota     String?  // no. nota / no. transaksi / no. BAST (opsional)
  mitraId    Int?     // diisi jika sumber MOU atau BANTUAN
  foto       String?  // nama file foto nota, HANYA untuk sumber PEMBELIAN
  // Biaya di luar barang, HANYA untuk PEMBELIAN. Minus = potongan. Contoh:
  // [{ "nama": "Ongkos kirim", "jumlah": 20000 }, { "nama": "Diskon ongkir", "jumlah": -20000 }]
  biayaLain  Json?
  keterangan String?
  createdAt  DateTime @default(now())

  mitra Mitra?            @relation(fields: [mitraId], references: [id], onDelete: SetNull)
  items BarangMasukItem[]

  @@index([tanggal])
  @@index([sumber])
}

// Barang-barang di dalam satu nota.
// Jumlah seharusnya sebuah barang = total jumlah di tabel ini.
model BarangMasukItem {
  id            Int  @id @default(autoincrement())
  barangMasukId Int
  barangId      Int
  jumlah        Int
  harga         Int? // harga satuan (rupiah), diisi jika sumber PEMBELIAN

  barangMasuk BarangMasuk @relation(fields: [barangMasukId], references: [id], onDelete: Cascade)
  barang      Barang      @relation(fields: [barangId], references: [id])

  @@index([barangMasukId])
  @@index([barangId])
}

model Pengecekan {
  id        Int      @id @default(autoincrement())
  lokasiId  Int
  tanggal   DateTime
  petugas   String   // diisi manual oleh yang mengecek
  catatan   String?
  createdAt DateTime @default(now())

  lokasi Lokasi           @relation(fields: [lokasiId], references: [id])
  items  PengecekanItem[]

  @@index([lokasiId, tanggal])
  @@index([tanggal])
}

// Baik   = jumlahAda - rusakRingan - rusakBerat   (dihitung, tidak disimpan)
// Hilang = jumlah seharusnya - jumlahAda          (dihitung, tidak disimpan)
// Di layar, rusakRingan ditampilkan sebagai "Kurang Baik" (sesuai istilah sekolah)
model PengecekanItem {
  id           Int     @id @default(autoincrement())
  pengecekanId Int
  barangId     Int
  jumlahAda    Int     // semua yang fisiknya ditemukan
  rusakRingan  Int     @default(0) // "Kurang Baik", bagian dari jumlahAda
  rusakBerat   Int     @default(0) // bagian dari jumlahAda
  keterangan   String?

  pengecekan Pengecekan @relation(fields: [pengecekanId], references: [id], onDelete: Cascade)
  barang     Barang     @relation(fields: [barangId], references: [id])

  @@unique([pengecekanId, barangId])
}

// Bulan pengecekan yang ditambahkan admin (masuk ke tahun ajaran sesuai tanggalnya)
model PeriodePengecekan {
  id        Int      @id @default(autoincrement())
  bulan     DateTime @unique // tanggal 1 bulan tersebut, jam 00:00 WIB
  createdAt DateTime @default(now())
}

// Pengajuan barang dari user untuk lokasinya, seperti pesan:
// daftar barang yang diminta + alasan umum. Tanggal otomatis dari createdAt.
model Pengajuan {
  id        Int      @id @default(autoincrement())
  lokasiId  Int      // untuk lokasi mana
  userId    Int?     // yang mengajukan; kosong jika akunnya sudah dihapus
  alasan    String   @db.Text
  createdAt DateTime @default(now())

  lokasi Lokasi          @relation(fields: [lokasiId], references: [id])
  user   User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  items  PengajuanItem[]

  @@index([lokasiId])
  @@index([userId])
  @@index([createdAt])
}

// Barang yang diminta dalam satu pengajuan (ketik bebas)
model PengajuanItem {
  id          Int     @id @default(autoincrement())
  pengajuanId Int
  nama        String  // misal "Kunci torsi"
  merk        String?
  jumlah      Int
  satuan      String  // Pcs, Set, Unit, Buah

  pengajuan Pengajuan @relation(fields: [pengajuanId], references: [id], onDelete: Cascade)

  @@index([pengajuanId])
}

// BARU: riwayat percobaan login, dipakai untuk:
// - kunci akun: 5 kali salah dalam 15 menit → dikunci 15 menit (per email), 20 kali per IP
// - bukti kalau ada serangan (siapa, dari IP mana, kapan)
// Disimpan 30 hari, lalu dihapus otomatis.
model PercobaanLogin {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(254)
  ip        String   @db.VarChar(45) // IPv6 terpanjang 45 karakter
  berhasil  Boolean
  alasan    String?  @db.VarChar(20) // "password" | "menunggu" | "terkunci" | null (berhasil)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}